# Server-only PostgreSQL connection strings. Never prefix these with VITE_.
# Vercel runtime: Supabase Transaction Pooler URI (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Schema migrations: Supabase direct connection URI (port 5432) or Session Pooler.
# Keep this out of client-side bundles and set it only in trusted CI/local environments.
DIRECT_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
